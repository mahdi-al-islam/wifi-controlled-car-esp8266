#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

ESP8266WebServer server(80);

// ===== MOTOR PINS =====
#define IN1 D1
#define IN2 D2
#define IN3 D3
#define IN4 D4
#define ENA D5
#define ENB D6

int speedVal = 800;
unsigned long lastCmdTime = 0;

// ===== SETUP =====
void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  stopMotor();

  analogWrite(ENA, speedVal);
  analogWrite(ENB, speedVal);

  WiFi.softAP("Robot_Car", "12345678");

  server.on("/", handleRoot);
  server.on("/move", handleMove);
  server.on("/speed", handleSpeed);

  server.begin();
}

// ===== LOOP =====
void loop() {
  server.handleClient();
}

// ================= WEB PAGE =================
void handleRoot() {
  String html = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body {
  font-family: Arial;
  background: #f2f4f7;
  text-align: center;
}
.container {
  max-width: 360px;
  margin: auto;
  padding: 20px;
}
.btn {
  width: 110px;
  height: 55px;
  font-size: 16px;
  margin: 6px;
  border: none;
  border-radius: 8px;
  background: #4a6fa5;
  color: white;
}
.stop {
  background: #d9534f;
}
input[type=range] {
  width: 100%;
}
</style>
</head>

<body>
<div class="container">
  <h2>Wi-Fi Robot Controller</h2>

  <button class="btn" onclick="cmd('F')">Forward</button><br>

  <button class="btn" onclick="cmd('L')">Left</button>
  <button class="btn stop" onclick="cmd('S')">Stop</button>
  <button class="btn" onclick="cmd('R')">Right</button><br>

  <button class="btn" onclick="cmd('B')">Backward</button>

  <p>Speed</p>
  <input type="range" min="0" max="1023" value="800"
         oninput="setSpeed(this.value)">
</div>

<script>
function cmd(c){
  fetch('/move?dir=' + c);
}
function setSpeed(v){
  fetch('/speed?val=' + v);
}
</script>
